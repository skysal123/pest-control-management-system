# Flask
SECRET_KEY=change-this-to-a-random-secret

# Database (use sqlite by default for development)
DATABASE_URL=sqlite:///instance/onestep.db

# Mail (Gmail example — create an App Password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Business
BUSINESS_NAME=OneStep MultiServices
BUSINESS_PHONE=+91-9876543210
BUSINESS_EMAIL=care@onestepmultiservices.com
BUSINESS_WHATSAPP=919876543210
BUSINESS_ADDRESS=123 Service Lane, Pune, Maharashtra, India
BUSINESS_CITY=Pune

# Warranty (90 days default, reminder 7 days before expiry)
WARRANTY_DAYS=90
WARRANTY_REMINDER_DAYS_BEFORE=7
